# Porchlight env template — copy to .env and fill every value. Never commit .env.
# HAC-24 pre-conditions: AWS, BEDROCK_MODEL_ID, Supabase (new project or
# `porchlight` schema — never Rebuttal's tables), TWILIO_*, both Twilio numbers,
# OWNER_PHONE, PHONE_ALLOWLIST, DEMO_ZONE, ROSTER_MODE=synthetic.

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Bedrock
BEDROCK_MODEL_ID=

# Supabase (new project or `porchlight` schema — never Rebuttal's tables)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Number A = coordinator channel, Number B = resident/volunteer channel
TWILIO_NUMBER_A=
TWILIO_NUMBER_B=

# Safety / demo scoping
OWNER_PHONE=
PHONE_ALLOWLIST=
DEMO_ZONE=
ROSTER_MODE=synthetic
# LIVE_ZONE is never set during the hackathon. Outreach fires only for DEMO_ZONE fixtures.
# LIVE_ZONE=

# Google Calendar (token refresh is WARN-only in preflight)
GOOGLE_CALENDAR_REFRESH_TOKEN=
