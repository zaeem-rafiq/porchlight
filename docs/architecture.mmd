flowchart TB
    NWS["NWS active alerts"]
    EB["EventBridge poll and tick adapters"]
    TG["Telegram sandbox<br/>Resident, coordinator, volunteer roles<br/>Owner chat receives real messages"]
    CONSOLE["Local Next.js console<br/>Roster and audit timeline<br/>Access-key-protected drill controls"]

    subgraph LAMBDA["AWS Lambda adapters"]
        POLL["NWS poll handler"]
        TICK["Tick handler"]
        INBOUND["Inbound Function URL<br/>Webhook secret and sender checks<br/>Separate console access-key check"]
    end
    NWS --> POLL
    EB --> POLL
    EB --> TICK
    TG --> INBOUND
    CONSOLE -->|"drill actions + access key"| INBOUND

    subgraph RUNTIME["Amazon Bedrock AgentCore Runtime — Python action handlers"]
        ROUTER["Route alert, resident reply, coordinator decision,<br/>volunteer reply, timer tick"]
        CONTACT["Deterministic vulnerability tiers<br/>Preserve contact state; allowlisted outreach"]
        TRIAGE["Interpret individual free-text reply<br/>Strands Agent + validated structured Triage<br/>1, 2, STOP handled in code"]
        GATE["Persisted coordinator decision queue<br/>Deterministic gate: current menu code + selected case"]
        REQUEST["Store volunteer request before sending<br/>Authenticated Y / N + reviewed request ID<br/>Persist acceptance or decline"]
        ROUTER --> CONTACT
        ROUTER --> TRIAGE
        TRIAGE -->|"help, medical, unclear"| GATE
        ROUTER -->|"coordinator reply"| GATE
        GATE -->|"approved volunteer request"| REQUEST
        ROUTER -->|"volunteer reply"| REQUEST
    end
    POLL --> ROUTER
    TICK --> ROUTER
    INBOUND --> ROUTER
    CONTACT -->|"check-in"| TG
    GATE -->|"case menu"| TG
    REQUEST -->|"request + ID"| TG

    BEDROCK["Amazon Bedrock via Strands BedrockModel<br/>status, need, confidence, reason, verbatim quote"]
    DB[("Supabase PostgreSQL<br/>contacts, gate_pending, dispatches, audit_log<br/>Persisted state; conditional updates and unique indexes")]
    SECRETS["AWS Secrets Manager<br/>Private runtime integration configuration"]
    TRIAGE <--> BEDROCK
    RUNTIME <-->|"workflow state and audit"| DB
    RUNTIME -->|"resolve configuration"| SECRETS
    DB -->|"read synthetic roster and audit"| CONSOLE
    SCOPE["Verified sandbox: 40 synthetic contacts<br/>Initial outreach: 1 owner delivery + 39 simulated<br/>Inbound drill messages were test-generated<br/>Real Bedrock and Telegram calls observed<br/>No resident pilot or completed visit claimed"]
    RUNTIME -.-> SCOPE
